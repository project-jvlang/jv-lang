fun describeInt(value: Int): String {
    return when (value % 2 == 0) {
        true -> "${value} is an even Int"
        false -> "${value} is an odd Int"
    }
}

fun describeString(value: String): String {
    return when (value.length > 5) {
        true -> "Long text (${value.length} chars)"
        false -> "Short text (${value.length} chars)"
    }
}

fun describeFlag(value: Boolean): String {
    return when (value) {
        true -> "Flag is set"
        false -> "Flag is off"
    }
}

fun main(): Unit {
    println(describeInt(42))
    println(describeString("companion notebook"))
    println(describeFlag(false))
}
