data Event(val label: String, val priority: Int)

fun describeInt(value: Int): String {
    return when (value % 2 == 0) {
        true -> "${value} is even"
        false -> "${value} is odd"
    }
}

fun describeString(value: String): String {
    return when (value.startsWith("jv")) {
        true -> "${value} looks like a namespace"
        false -> "String ${value}"
    }
}

fun describeEvent(value: Event): String {
    return "Event ${value.label} (${value.priority})"
}

fun main(): Unit {
    println(describeInt(10))
    println(describeString("jv.tour"))
    println(describeEvent(Event("checkpoint" 2)))
}
