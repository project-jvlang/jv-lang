fun main(): Unit {
    val div = divmod(27 4)
    val divQuotient = div.quotient()
    val divRemainder = div.remainder()
    println("divmod(27, 4) -> quotient=${divQuotient} remainder=${divRemainder}")

    val user = findUser(1)
    val userId = user.userId()
    val userName = user.userName()
    println("findUser(1) -> id=${userId} name=${userName}")

    val stats = calculateStats(9 2 5)
    val minValue = stats.minValue()
    val maxValue = stats.maxValue()
    val totalSum = stats.totalSum()
    println("calculateStats(9, 2, 5) -> min=${minValue} max=${maxValue} total=${totalSum}")

    val labelPriority = (
        // commentPrimary
        "primary"
        // commentSecondary
        2
        99
    )
    println("labelPriority third=${labelPriority._3()}")
}

fun divmod(dividend: Int, divisor: Int): (Int Int) {
    val quotient: Int = dividend / divisor
    val remainder: Int = dividend % divisor
    return (
        quotient // quotient
        remainder // remainder
    )
}

fun findUser(id: Int): (Int String) {
    val name = when (id == 1) {
        true -> "Alice"
        false -> "Unknown"
    }
    return (
        id // userId
        name // userName
    )
}

fun calculateStats(a: Int, b: Int, c: Int): (Int Int Int) {
    val minCandidate: Int = minOfInt(minOfInt(a b) c)
    val maxCandidate: Int = maxOfInt(maxOfInt(a b) c)
    val total: Int = a + b + c
    return (
        minCandidate // minValue
        maxCandidate // maxValue
        total // totalSum
    )
}

fun minOfInt(left: Int, right: Int): Int {
    return when (left <= right) {
        true -> left
        false -> right
    }
}

fun maxOfInt(left: Int, right: Int): Int {
    return when (left >= right) {
        true -> left
        false -> right
    }
}
