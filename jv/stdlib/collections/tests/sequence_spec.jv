package jv.stdlib.collections.tests

import java.util.Map
import jv.collections.sequenceFromIterable

data Person(name: String age: Int)

fun <T> collect(stream: Stream<T>): List<T> {
    val bucket = ArrayList<T>()
    stream.forEach { element -> bucket.add(element) }
    return bucket
}

fun <T> assertList(actual: List<T>, expected: List<T>, label: String) {
    when (actual == expected) {
        true -> {}
        else -> throw IllegalStateException("${label} expected ${expected} but was ${actual}")
    }
}

fun assertInt(actual: Int, expected: Int, label: String) {
    when (actual == expected) {
        true -> {}
        else -> throw IllegalStateException("${label} expected ${expected} but was ${actual}")
    }
}

fun assertLong(actual: Long, expected: Long, label: String) {
    when (actual == expected) {
        true -> {}
        else -> throw IllegalStateException("${label} expected ${expected} but was ${actual}")
    }
}

fun validateSampleSingleStageOperations() {
    numbers = [1 2 3 4 5]

    doubled = collect(numbers.map { value -> value * 2 })
    assertList(doubled [2 4 6 8 10] "map")

    evens = collect(numbers.filter { value -> value % 2 == 0 })
    assertList(evens [2 4] "filter")

    sum = numbers.reduce { left right -> left + right }
    assertInt(sum 15 "reduce")
}

fun validatePhase1MapFilterToList() {
    numbers = [1 2 3 4 5]
    result = collect(
        numbers
            .map { value -> value * 2 }
            .filter { candidate -> candidate >= 6 }
    )

    expected = [6 8 10]
    assertList(result expected "map/filter")
}

fun validatePhase1SequenceFromIterableToList() {
    numbers = [10 20 30]
    sequence = sequenceFromIterable(numbers)
    result = collect(
        sequence
            .map { value -> value / 10 }
    )

    expected = [1 2 3]
    assertList(result expected "sequenceFromIterable map")
}

fun validatePhase1FilterOnlyChain() {
    numbers = [5 6 7 8 9]
    result = collect(
        numbers
            .filter { value -> value % 2 == 0 }
    )

    expected = [6 8]
    assertList(result expected "filter/toList")
}

fun validatePhase2TakeDropChain() {
    numbers = [1 2 3 4 5 6]
    result = collect(
        numbers
            .map { value -> value * 10 }
            .drop(2)
            .take(3)
    )

    expected = [30 40 50]
    assertList(result expected "drop/take chain")
}

fun validatePhase2FlatMapFromIterable() {
    groups = [
        [1 2]
        [3 4]
        [5]
    ]

    result = collect(
        groups
            .flatMap { group -> group }
    )

    expected = [1 2 3 4 5]
    assertList(result expected "flatMap from iterable")
}

fun validatePhase2FlatMapFromSequence() {
    base = sequenceFromIterable([1 2 3])
    result = collect(
        base
            .flatMap { value -> [value value * 10] }
            .take(4)
    )

    expected = [1 10 2 20]
    assertList(result expected "flatMap sequence")
}

fun validatePhase3FoldAggregates() {
    numbers = [1 2 3 4]
    total = numbers
        .map { value -> value * 2 }
        .fold(10) { acc value -> acc + value }

    assertInt(total 30 "fold")
}

fun validatePhase3ReduceAggregates() {
    numbers = sequenceFromIterable([5 6 7])
    reduceResult = numbers.reduce { left right -> left + right }

    assertInt(reduceResult 18 "reduce")
}

fun validatePhase3ReduceEmptyThrows() {
    emptySequence = sequenceFromIterable([])

    try {
        emptySequence.reduce { left right -> left + right }
        throw IllegalStateException("reduce on empty sequence should throw IllegalArgumentException")
    } catch (error: IllegalArgumentException) {
        // expected
    }
}

fun validatePhase3CountAndSum() {
    numbers = [2 4 6 8]
    countResult = numbers.count()
    assertLong(countResult 4L "count")

    sumResult = numbers
        .map { value -> value + 1 }
        .sum()

    assertLong(sumResult 24L "sum")
}

fun validatePhase4SortedSequence() {
    numbers = [5 2 4 1 3]
    result = collect(numbers.sorted())

    expected = [1 2 3 4 5]
    assertList(result expected "sorted")
}

fun validatePhase4SortedBySequence() {
    people = [
        Person("Carol" 40)
        Person("Alice" 32)
        Person("Bob" 28)
    ]

    result = collect(
        people
            .sortedBy { person -> person.age }
    )

    expected = [
        Person("Bob" 28)
        Person("Alice" 32)
        Person("Carol" 40)
    ]

    assertList(result expected "sortedBy")
}

fun validatePhase4GroupByOperation() {
    words = ["alpha" "amber" "bravo" "blue"]
    grouped = words.groupBy { word -> word.substring(0 1) }

    assertInt(grouped.size() 2 "groupBy buckets")

    aBucket = grouped.get("a")
    when (aBucket == null || aBucket != ["alpha" "amber"]) {
        true -> throw IllegalStateException("groupBy bucket 'a' expected [alpha amber] but was ${aBucket}")
    }

    bBucket = grouped.get("b")
    when (bBucket == null || bBucket != ["bravo" "blue"]) {
        true -> throw IllegalStateException("groupBy bucket 'b' expected [bravo blue] but was ${bBucket}")
    }
}

fun validatePhase4AssociateOperation() {
    entries = [
        Person("Alice" 32)
        Person("Bob" 28)
        Person("Bob" 35)
    ]

    associated = entries.associate { person -> Map.entry(person.name person.age) }

    if (associated.size() != 2) {
        throw IllegalStateException("associate expected size 2 but was ${associated.size()}")
    }

    val aliceAge = associated.get("Alice")
    if (aliceAge != 32) {
        throw IllegalStateException("associate expected Alice -> 32 but was ${aliceAge}")
    }

    val bobAge = associated.get("Bob")
    if (bobAge != 35) {
        throw IllegalStateException("associate expected Bob -> 35 but was ${bobAge}")
    }
}

fun validatePhase5ForEachSideEffects() {
    numbers = [1 2 3 4]
    var total = 0

    numbers
        .map { value -> value * 3 }
        .forEach { value -> total = total + value }

    if (total != 30) {
        throw IllegalStateException("forEach expected total 30 but was ${total}")
    }
}

fun validatePrimitiveStreamSumSpecialization() {
    charValues = ['A' 'B' 'C']

    charSum = charValues.sum()
    if (charSum != (65 + 66 + 67)) {
        throw IllegalStateException("sum expected 198 for Character aliases but was ${charSum}")
    }

    shortValues = [5S 7S 9S]

    shortSum = shortValues.sum()
    if (shortSum != 21) {
        throw IllegalStateException("sum expected 21 for Short aliases but was ${shortSum}")
    }

    intValues = [10 20 30]
    intSum = intValues.sum()
    if (intSum != 60) {
        throw IllegalStateException("sum expected 60 for Integer aliases but was ${intSum}")
    }

    longValues = [100L 200L 300L]
    longSum = longValues.sum()
    if (longSum != 600L) {
        throw IllegalStateException("sum expected 600L but was ${longSum}")
    }

    floatValues = [1.5f 2.5f 3.0f]
    floatSum = floatValues.sum()
    if (floatSum != 7.0f) {
        throw IllegalStateException("sum expected 7.0f but was ${floatSum}")
    }

    doubleValues = [1.25 2.75 3.0]
    doubleSum = doubleValues.sum()
    if (doubleSum != 7.0) {
        throw IllegalStateException("sum expected 7.0 but was ${doubleSum}")
    }
}
